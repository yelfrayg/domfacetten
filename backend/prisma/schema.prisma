generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Product {
  arttype     String
  artnr       Int     @id
  name        String
  description String
  keywords    Json
  price       Decimal
  inStock     Int
  heroImage   String
  image2      String?
  image3      String?
  cart        Cart[]
}

model Orders {
  orderId    String       @id @default(cuid())
  captureId  String?      @unique
  products   Json
  timestamp  DateTime     @default(now())
  customerId String
  code       Json?
  user       Users?       @relation(fields: [customerId], references: [userId], onDelete: SetNull)
  withdraw   Withdrawal[]
}

model Codes {
  codeId    String  @id @db.Text
  codeValue Float
  expired   Boolean @default(true)
}

model Users {
  userId     String       @id @default(cuid())
  email      String       @unique
  first_name String       @default("")
  last_name  String       @default("")
  password   String
  address    Json         @default(dbgenerated("'{}'"))
  orders     Orders[] // [] = 1:n relation
  cart       Cart[]
  otp        Int          @default(000000)
  otpExpiry  DateTime     @default(now())
  withdraws  Withdrawal[]
}

model Cart {
  cartId    String  @id @default(cuid())
  userId    String
  user      Users   @relation(fields: [userId], references: [userId], onDelete: Cascade)
  productId Int
  product   Product @relation(fields: [productId], references: [artnr])
  quantity  Int     @default(1)

  @@unique([userId, productId])
}

model Withdrawal {
  withdrawalId   String   @id @default(cuid())
  userId         String
  orderId        String
  amount         Decimal
  status         String   @default("PENDING")
  declaredAt     DateTime @default(now())
  withDrawalItem Json

  user  Users  @relation(fields: [userId], references: [userId], onDelete: Cascade)
  order Orders @relation(fields: [orderId], references: [orderId], onDelete: Restrict)
}
